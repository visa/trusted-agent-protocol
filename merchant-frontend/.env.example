# Development: empty/unset uses relative /api paths through the current origin.
VITE_API_BASE_URL=
# An absolute base (without /api) bypasses the current origin's proxy.
# Production builds default to http://localhost:8000 when this value is empty.
# VITE_CDN_PROXY_URL, VITE_API_URL, and VITE_DEBUG_MODE are not consumed.
