# Generate your own keys; never commit the resulting .env file.
# The quickstart's demo_request.py can create Ed25519 values in a NEW env file.
# Raw 32-byte seeds/public keys in standard Base64, NOT PEM or Base64url:
ED25519_PRIVATE_KEY=<raw-private-seed-base64>
ED25519_PUBLIC_KEY=<raw-public-key-base64>

# Optional legacy RSA-PSS/SHA-256 signing. Use matching quoted multiline PEM values:
# RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----"
# RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
# ...
# -----END PUBLIC KEY-----"
# Merchant URL is configured in the UI; Streamlit port uses --server.port.
